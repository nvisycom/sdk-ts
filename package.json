{
	"name": "@nvisy/sdk",
	"version": "0.32.0",
	"description": "Official TypeScript SDK for Nvisy document processing platform",
	"type": "module",
	"private": false,
	"keywords": [
		"nvisy",
		"sdk",
		"api",
		"client",
		"typescript",
		"redaction",
		"anonymization",
		"pii",
		"phi",
		"data-privacy",
		"data-masking",
		"sensitive-data",
		"document-processing"
	],
	"author": "Nvisy <support@nvisy.com>",
	"license": "MIT",
	"homepage": "https://github.com/nvisycom/sdk-ts#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nvisycom/sdk-ts.git"
	},
	"bugs": {
		"url": "https://github.com/nvisycom/sdk-ts/issues"
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./auth": {
			"types": "./dist/auth/index.d.ts",
			"import": "./dist/auth/index.js"
		},
		"./services": {
			"types": "./dist/services/index.d.ts",
			"import": "./dist/services/index.js"
		},
		"./datatypes": {
			"types": "./dist/datatypes/index.d.ts",
			"import": "./dist/datatypes/index.js"
		},
		"./webhooks": {
			"types": "./dist/webhooks/index.d.ts",
			"import": "./dist/webhooks/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE.txt",
		"CHANGELOG.md",
		"CONTRIBUTING.md"
	],
	"scripts": {
		"build": "tsdown",
		"build:watch": "tsdown --watch",
		"dev": "tsdown --watch",
		"test": "vitest",
		"test:watch": "vitest --watch",
		"test:coverage": "vitest --coverage",
		"test:ui": "vitest --ui",
		"test:e2e": "vitest run --config vitest.e2e.config.ts",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
		"clean": "rimraf dist",
		"prepublishOnly": "npm run clean && npm run build && npm run test",
		"release": "npm run prepublishOnly && npm publish",
		"generate:check": "curl -sf https://api.nvisy.com/openapi.json -o /dev/null",
		"generate:check:local": "curl -sf http://127.0.0.1:8080/api/openapi.json -o /dev/null",
		"generate": "openapi-typescript https://api.nvisy.com/openapi.json --default-non-nullable false -o ./src/schema/api.d.ts",
		"generate:local": "openapi-typescript http://127.0.0.1:8080/api/openapi.json --default-non-nullable false -o ./src/schema/api.d.ts",
		"generate:clean": "rimraf ./src/schema/api.d.ts",
		"audit:coverage": "node scripts/audit-coverage.mjs",
		"audit:coverage:remote": "node scripts/audit-coverage.mjs https://api.nvisy.com/openapi.json"
	},
	"dependencies": {
		"openapi-fetch": "^0.17.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@types/node": "^26.1.2",
		"@vitest/coverage-v8": "^4.1.9",
		"@vitest/ui": "^4.1.9",
		"openapi-typescript": "^7.13.0",
		"rimraf": "^6.1.3",
		"tsdown": "^0.22.14",
		"typescript": "^5.9.3",
		"vitest": "^4.1.9"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
